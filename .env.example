# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" and never paste real passwords into this example file.

# ---- SMTP server ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (local debug servers only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Address shown in the From header (must be allowed by your SMTP provider)
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_TIMEOUT_SECONDS=30

# ---- Safety ----
# "test" (default): every email is redirected to TEST_RECIPIENT, whatever you select.
# "live": real recipients are allowed, but the dashboard still demands explicit confirmation.
SEND_MODE=test
# An address YOU control. Required for test mode.
TEST_RECIPIENT=
MAX_ATTEMPTS=3
SEND_DELAY_SECONDS=1
MAX_BATCH_SIZE=50

# ---- Sender details (you can also edit these in the dashboard sidebar) ----
# Leave blank if unsure: the app will refuse to send until they are set.
SENDER_NAME=
SENDER_TITLE=

# ---- Storage ----
DB_PATH=data/shortfundly.db

# ---- Admin dashboard login ----
# Credentials for the Streamlit admin login screen.
# Demo defaults (used if left unset): username 'admin', password 'admin@123'.
# Change these before any real/official use.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ==============================================================================
# FULL AUTOMATION SETTINGS (Phase 4)
# ==============================================================================

# ---- College Discovery (Seed CSV) ----
# Path to the CSV of colleges to monitor. Imported automatically on every worker run.
# Columns: name, website, state, city, institution_type
SEED_CSV_PATH=data/seed_colleges.csv

# ---- Auto-Approve ----
# Set to true to automatically approve scraped contacts that pass quality checks.
# Contacts scoring >= AUTO_APPROVE_THRESHOLD (0-100) are approved without human review.
# Contacts below the threshold remain as 'pending_review' for manual action.
AUTO_APPROVE_ENABLED=false
AUTO_APPROVE_THRESHOLD=80

# ---- Auto-Send ----
# Set BOTH to true to automatically send emails after monitoring finds new contacts.
# REQUIRES: SEND_MODE=live  AND  AUTO_SEND_ENABLED=true
# The campaign label is used for deduplication (one email per contact per campaign).
AUTO_SEND_ENABLED=false
AUTO_SEND_CAMPAIGN=auto

# ---- Monitoring Worker ----
# Interval between automated monitoring runs: 6h | 12h | daily | weekly | manual
MONITOR_INTERVAL=daily
MAX_PAGES_PER_COLLEGE=5
MAX_COLLEGES_PER_RUN=25
REQUEST_TIMEOUT=20
RETRY_COUNT=3
PER_DOMAIN_DELAY=2.0
